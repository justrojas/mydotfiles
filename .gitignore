# Sensitive configuration files (tokens, secrets, etc.)
# NOTE: secrets belong in ~/.env, which both rc files source last. Never put a
# token in config/bash/.bashrc or config/zsh/.zshrc — those are TRACKED files
# symlinked into $HOME, so anything hardcoded there lands in git.
.env
.env.*
.zshrc.work
.zshrc.local
.bashrc.work
.bashrc.local
*.secret
**/secrets.*

# Backup files
*.backup
*.bak
*.bak.*
*~

# OS-specific files
.DS_Store
Thumbs.db

# Editor-specific files
*.swp
*.swo
.vscode/
.idea/

# Cache and temporary files
*.cache
*.log
.zcompdump*

# Misplaced config directories (managed by KDE, not tracked here)
.config/latte/

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Runtime state accidentally captured from live config dirs
*.lock
.touchegg*.lock

# Compiled/build artifacts
*.o
*.a
